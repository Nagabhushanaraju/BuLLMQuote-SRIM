{
  "name": "@accomplish/daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Accomplish background daemon process",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node dist/index.js",
    "dev": "node scripts/dev.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "clean": "node -e \"import('fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "init-db": "node scripts/init-db.cjs"
  },
  "dependencies": {
    "@accomplish_ai/agent-core": "workspace:*",
    "@opencode-ai/sdk": "1.14.18",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.17"
  }
}
